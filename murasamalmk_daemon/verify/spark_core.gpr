--  Ravenscar verification project for Murasama_Guard.
--
--  The daemon partition cannot use pragma Profile (Ravenscar) (tasks,
--  rendezvous, Text_IO, FFI), but the exclusion decision is Pure SPARK and
--  is proved here under Ravenscar.
--
--  Run:  cd verify && gnatprove --mode=all --level=4 -P spark_core.gpr

project Spark_Core is
   for Languages use ("Ada");
   for Source_Dirs use ("../src");
   for Source_Files use ("murasama_guard.ads", "murasama_guard.adb");
   for Object_Dir use "obj";
end Spark_Core;
